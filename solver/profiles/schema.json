{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://php2shell-aslr.local/profile-schema-v2.json",
  "title": "PHP2Shell calibrated profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "scope",
    "image",
    "image_digest",
    "php_version",
    "branch",
    "fixed_in",
    "arch",
    "distro",
    "sapi",
    "upstream_commit",
    "libphp_path",
    "libphp_sha256",
    "libphp",
    "stages",
    "measured",
    "config",
    "verified",
    "rce",
    "status"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "generated_at": {"type": "string", "format": "date-time"},
    "scope": {"const": "local-calibration"},
    "image": {"type": "string", "minLength": 1},
    "image_digest": {"type": "string", "minLength": 1},
    "php_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "branch": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "fixed_in": {"type": ["string", "null"]},
    "arch": {"enum": ["amd64", "aarch64"]},
    "distro": {"type": "string", "minLength": 1},
    "sapi": {"const": "apache2handler"},
    "upstream_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "libphp_path": {"type": "string", "minLength": 1},
    "libphp_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "libphp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zif_system", "zval_ptr_dtor", "htdata"],
      "properties": {
        "zif_system": {"$ref": "#/$defs/hexOffset"},
        "zval_ptr_dtor": {"$ref": "#/$defs/hexOffset"},
        "htdata": {"type": ["null", "string"], "pattern": "^0x[0-9a-f]+$"}
      }
    },
    "stages": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage1_n",
        "stage1_forge_len",
        "stage2_t",
        "stage2_v",
        "stage3_pads",
        "stage3_carrier"
      ],
      "properties": {
        "stage1_n": {"type": "integer", "minimum": 0},
        "stage1_forge_len": {"type": "integer", "minimum": 0},
        "stage2_t": {"type": "integer", "minimum": 0},
        "stage2_v": {"type": "integer", "minimum": 0},
        "stage3_pads": {
          "type": ["null", "array"],
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {"type": "integer", "minimum": 0}
          }
        },
        "stage3_carrier": {"type": ["boolean", "null"]}
      }
    },
    "measured": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zend_chunk_base", "libphp_base"],
      "properties": {
        "zend_chunk_base": {"type": ["null", "string"], "pattern": "^0x[0-9a-f]+$"},
        "libphp_base": {"type": ["null", "string"], "pattern": "^0x[0-9a-f]+$"}
      }
    },
    "config": {
      "type": "object",
      "required": ["memory_limit", "session_upload_progress", "workers"],
      "additionalProperties": true,
      "properties": {
        "memory_limit": {"type": ["string", "integer", "null"]},
        "session_upload_progress": {"type": ["string", "integer", "null"]},
        "workers": {"type": ["integer", "null"]}
      }
    },
    "verified": {"type": "boolean"},
    "rce": {"type": "boolean"},
    "status": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "hexOffset": {"type": "string", "pattern": "^0x[0-9a-f]+$"},
    "nullableHexPointer": {"type": ["null", "string"], "pattern": "^0x[0-9a-f]+$"}
  },
  "if": {"properties": {"rce": {"const": true}}},
  "then": {
    "properties": {
      "verified": {"const": true},
      "libphp": {
        "properties": {
          "htdata": {"pattern": "^0x[0-9a-f]+$"}
        }
      },
      "stages": {
        "properties": {
          "stage1_n": {"minimum": 1},
          "stage1_forge_len": {"minimum": 1},
          "stage2_t": {"minimum": 1},
          "stage2_v": {"minimum": 1}
        }
      }
    }
  }
}
